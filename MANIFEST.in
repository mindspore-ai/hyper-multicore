include README.md README.en.md LICENSE Third_Party_Open_Source_Software_Notice
include build.sh requirements.txt scripts/hyper_multicore_build_info
include .clang-format .codespellrc .pylintrc .gitattributes .pre-commit-config.yaml .markdownlint.jsonc
recursive-include hyper_multicore *.py *.sh *.bash *.cpp *.cc *.h *.hpp *.cmake CMakeLists.txt CPPLINT.cfg *.patch *.json *.ini *.md *.txt
recursive-include scripts *.py *.sh *.bash
recursive-include tests *.py *.cpp *.h *.hpp *.md
recursive-include examples *.py *.md *.sh
recursive-include docs *.md
prune docs/migration
prune build
prune dist
prune .git
global-exclude __pycache__ *.py[cod] *.so *.pyd *.dylib *.dll
exclude hyper_multicore/build_info.json
