+    } else switch (getDiagnosticMode(this->runtimeConfigPtr)) {
       case DiagnosticMode::PROFILE:
         ProcessProfiled();
         break;
@@ -145,6 +148,68 @@ class KernelWorkerBase {
   }
 
  protected:
+  __aicore__ inline bool DependencyReady(const TaskDesc &task) {
+    if (task.dependent_event == EVENT_INVALID_ID) return true;
+    if (task.dependent_event >= runtime_event_capacity) AscendC::Trap();
+    DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(
+      all_event_counters[task.dependent_event]);
+    return all_event_counters.GetValue(task.dependent_event) >= all_event_num_triggers.GetValue(task.dependent_event);
+  }
+
+  __aicore__ inline void ProcessWorkerQueue() {
+#ifdef __DAV_CUBE__
+    const uint32_t record_index = this->worker_id_;
+#else
+    const uint32_t record_index = this->core_num + this->worker_id_;
+#endif
+    const WorkerQueue queue = getWorkerQueue(this->runtimeConfigPtr, record_index);
+    const auto mode = getDiagnosticMode(this->runtimeConfigPtr);
+    CycleTraceRecorder recorder;
+    if (mode == DiagnosticMode::PROFILE) {
+      recorder.Init(this->worker_id_, input_list[Derived::DIAGNOSTIC_IDX],
+                    getAicProfileRecordCapacity(runtimeConfigPtr), getAivProfileRecordCapacity(runtimeConfigPtr),
+                    getCubeWorkerCapacity(runtimeConfigPtr));
+    }
+    uint32_t head = queue.begin;
+    uint64_t completed = 0;
+    uint64_t idle_start = 0;
+    while (head < queue.end) {
+      uint32_t selected = head;
+      if (queue.ready_depth != 0) {
+        selected = queue.end;
+        for (uint32_t position = head; position < queue.end && position - head < queue.ready_depth; ++position) {
+          if (completed & (uint64_t{1} << (position - head))) continue;
+          TaskDesc task;
+          getTaskDesc(runtimeConfigPtr, &task, GetTaskIndex(position));
+          if (DependencyReady(task)) { selected = position; break; }
+        }
+        if (selected == queue.end) {
+          if (mode == DiagnosticMode::PROFILE && idle_start == 0) idle_start = recorder.Now();
+          const int64_t until = AscendC::GetSystemCycle() + 10 * SYSTEM_CYCLES_PER_US;
+          while (AscendC::GetSystemCycle() < until) {}
+          continue;
+        }
+      }
+      if (mode == DiagnosticMode::PROFILE && idle_start != 0) {
+        const TaskId blocked = GetTaskIndex(head);
+        TaskDesc blocked_task;
+        getTaskDesc(runtimeConfigPtr, &blocked_task, blocked);
+        recorder.Record(0x10008, blocked, blocked_task.task_index, getTaskProfileOwnerId(runtimeConfigPtr, blocked),
+                        idle_start, recorder.Now());
+        idle_start = 0;
+      }
+      const TaskId id = GetTaskIndex(selected);
+      if (mode == DiagnosticMode::PROFILE) ExecuteTaskProfiled(id, recorder);
+      else if (mode == DiagnosticMode::TENSOR_DUMP_L1) ExecuteTaskL1Dump(id);
+      else ExecuteTaskFast(id);
+      if (queue.ready_depth == 0) ++head;
+      else {
+        completed |= uint64_t{1} << (selected - head);
+        while (head < queue.end && (completed & 1)) { completed >>= 1; ++head; }
+      }
+    }
+  }
+
   __aicore__ inline void ProcessFast() {
 #ifdef __DAV_CUBE__
     uint32_t block_idx = this->worker_id_;
@@ -345,6 +410,7 @@ class KernelWorkerBase {
   }
 
   __aicore__ inline bool IsActiveVectorWorker() const {
+    if (getQueueLayout(this->runtimeConfigPtr) == 1) return this->worker_id_ < this->vector_num;
     if constexpr (WorkerPolicy == VectorWorkerPolicy::ALL) {
       return this->worker_id_ < this->active_vector_num;
     }
