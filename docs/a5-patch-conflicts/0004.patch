diff --git a/hyper_multicore/scheduler/worker_queues.py b/hyper_multicore/scheduler/worker_queues.py
new file mode 100644
index 0000000..4d7a9f2
--- /dev/null
+++ b/hyper_multicore/scheduler/worker_queues.py
@@ -0,0 +1,90 @@
