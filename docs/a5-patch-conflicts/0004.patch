   __aicore__ inline void Process() {
@@ -129,7 +130,9 @@ class KernelWorkerBase {
     if (has_ready) {
       WaitForDeviceReady(meta);
     }
-    switch (getDiagnosticMode(this->runtimeConfigPtr)) {
