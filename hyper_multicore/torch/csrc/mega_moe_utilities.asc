#include <cstdint>
#include "kernel_operator.h"

namespace {
using namespace AscendC;
constexpr int32_t kTileBytes = 32 * 1024;

__global__ __aicore__ void ZeroEmptyExpertGrad(
    GM_ADDR first, GM_ADDR second, GM_ADDR cumulative,
    int64_t first_expert_bytes, int64_t second_expert_bytes, int64_t experts) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, kTileBytes);
    auto zeros = buffer.Get<int32_t>();
    bool initialized = false;
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(cumulative));
    // A row is cold precisely when its cumulative count equals the previous
    // cumulative count. Every block scans only this short metadata vector.
    for (int64_t expert = 0; expert < experts; ++expert) {
        const int64_t before = expert == 0 ? 0 : groups.GetValue(expert - 1);
        if (groups.GetValue(expert) != before) {
            continue;
        }
        if (!initialized) {
            Duplicate(zeros, int32_t(0), kTileBytes / sizeof(int32_t));
            PipeBarrier<PIPE_ALL>();
            initialized = true;
        }
        for (int32_t projection = 0; projection < 2; ++projection) {
            const int64_t bytes = projection == 0 ? first_expert_bytes : second_expert_bytes;
            GM_ADDR base = projection == 0 ? first : second;
            for (int64_t offset = static_cast<int64_t>(GetBlockIdx()) * kTileBytes;
                 offset < bytes; offset += static_cast<int64_t>(GetBlockNum()) * kTileBytes) {
                const int32_t count = bytes - offset < kTileBytes ? bytes - offset : kTileBytes;
                GlobalTensor<uint8_t> target;
                target.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(base + expert * bytes + offset));
                const DataCopyExtParams copy{1, static_cast<uint32_t>(count), 0, 0, 0};
                DataCopyPad(target, zeros.ReinterpretCast<uint8_t>(), copy);
            }
        }
    }
    PipeBarrier<PIPE_ALL>();
}
}  // namespace
extern "C" void HmcLaunchZeroCold(unsigned blocks, void* stream, uint8_t* first,
                                   uint8_t* second, uint8_t* cumulative,
                                   int64_t first_bytes, int64_t second_bytes, int64_t experts) {
    ZeroEmptyExpertGrad<<<blocks, nullptr, stream>>>(first, second, cumulative, first_bytes, second_bytes, experts);
}

// PR19 routing_kernels.h, adapted to HyperMulticore row units.
using namespace AscendC;
namespace {
__aicore__ inline int64_t device_aligned(int64_t n) { return (n+7)/8*8; }
template <typename T>
__aicore__ inline void Load(LocalTensor<T> local, GM_ADDR address, int64_t count) {
    GlobalTensor<T> global;
    global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(address));
    DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
    DataCopyPadExtParams<T> pad{false, 0, 0, 0};
    DataCopyPad(local, global, copy, pad);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
}

template <typename T>
__aicore__ inline void Store(GM_ADDR address, LocalTensor<T> local, int64_t count) {
    GlobalTensor<T> global;
    global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(address));
    SetFlag<HardEvent::S_MTE3>(0);
    WaitFlag<HardEvent::S_MTE3>(0);
    DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
    DataCopyPad(global, local, copy);
    SetFlag<HardEvent::MTE3_S>(0);
    WaitFlag<HardEvent::MTE3_S>(0);
}

__global__ __aicore__ void Metadata(GM_ADDR input, GM_ADDR offsets, GM_ADDR sizes,
                                  int32_t p, int32_t e, int32_t rank, int32_t hidden_size,
                                  int32_t stride, int32_t group, int32_t programs,
                                  int32_t bytes, int32_t row_stride) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, bytes);
    auto memory = buffer.Get<int32_t>();
    auto c = memory;
    auto out = memory[device_aligned((p - 1) * row_stride + e)].ReinterpretCast<int64_t>();
    auto length = memory[device_aligned((p - 1) * row_stride + e) + 2 * stride];
    auto groups = memory[device_aligned((p - 1) * row_stride + e) + 3 * stride].ReinterpretCast<int64_t>();
    Load(c, input, (p - 1) * row_stride + e);
    const int32_t local = e / p;
    const int32_t block = GetBlockIdx();
    // Reuse the same loaded count table and UB scratch for both unit systems.
    for (int pass=0; pass<(hidden_size==1?1:2); ++pass) {
        const int32_t h=pass==0?1:hidden_size;
        auto output_offsets=offsets+static_cast<int64_t>(pass)*(4*stride+local)*8;
        auto output_sizes=sizes+static_cast<int64_t>(pass)*2*stride*4;
    if (block < programs) {
        for (int32_t source = block * group; source < p && source < (block + 1) * group; ++source) {
            int64_t prefix = 0;
            for (int32_t expert = 0; expert < e; ++expert) {
                int32_t n = c.GetValue(source * row_stride + expert);
                out.SetValue(expert, prefix * h);
                if (source == rank) length.SetValue(expert, n * h);
                prefix += n;
            }
            if (source == rank) {
                Store(output_offsets, out, e);
                Store(output_sizes, length, e);
            }
            for (int32_t j = 0; j < local; ++j) groups.SetValue(j, out.GetValue(rank * local + j));
            Store(output_offsets + (3 * stride + source * local) * 8, groups, local);
        }
    } else {
        int32_t begin = (block - programs) * group;
        for (int32_t dest = begin; dest < p && dest < begin + group; ++dest) {
            int64_t prefix = 0;
            for (int32_t j = 0; j < local; ++j) {
                int64_t source_prefix = 0;
                for (int32_t source = 0; source < p; ++source) {
                    int32_t n = c.GetValue(source * row_stride + dest * local + j);
                    out.SetValue(source * local + j, (prefix + source_prefix) * h);
                    if (dest == rank) length.SetValue(source * local + j, n * h);
                    source_prefix += n;
                }
                prefix += source_prefix;
                groups.SetValue(j, prefix);
            }
            if (dest == rank) {
                Store(output_offsets + 2 * stride * 8, out, e);
                Store(output_sizes + stride * 4, length, e);
                Store(output_offsets + 4 * stride * 8, groups, local);
            }
            for (int32_t j = 0; j < local; ++j) groups.SetValue(j, out.GetValue(rank * local + j));
            Store(output_offsets + (stride + dest * local) * 8, groups, local);
        }
    }
    }
}


}
extern "C" void HmcLaunchRouteMetadata(unsigned blocks,void* stream,uint8_t* counts,uint8_t* offsets,uint8_t* sizes,
    int32_t ep,int32_t experts,int32_t rank,int32_t stride,int32_t group,int32_t programs,int32_t bytes, int32_t row_stride, int32_t hidden_size) {
  Metadata<<<blocks,nullptr,stream>>>(counts,offsets,sizes,ep,experts,rank,hidden_size,stride,group,programs,bytes,row_stride);
}

// Reuse a validated forward permutation; no sorting or floating-point arithmetic.
namespace {
__global__ __aicore__ void PermuteFromMapping(
    GM_ADDR grad, GM_ADDR mapping, GM_ADDR probabilities, GM_ADDR output,
    GM_ADDR staged_probabilities, int64_t tokens, int64_t width_bytes, int64_t topk) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> data_buffer, probability_buffer;
    pipe.InitBuffer(data_buffer, kTileBytes);
    pipe.InitBuffer(probability_buffer, 32);
    auto data = data_buffer.Get<uint8_t>();
    auto probability = probability_buffer.Get<float>();
    GlobalTensor<int32_t> indices;
    GlobalTensor<float> probs;
    indices.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(mapping));
    probs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(probabilities));
    for (int64_t token = GetBlockIdx(); token < tokens; token += GetBlockNum()) {
        for (int64_t column = 0; column < width_bytes; column += kTileBytes) {
            const uint32_t bytes = width_bytes - column < kTileBytes ? width_bytes - column : kTileBytes;
            SetFlag<HardEvent::MTE3_MTE2>(0);
            WaitFlag<HardEvent::MTE3_MTE2>(0);
            GlobalTensor<uint8_t> source;
            source.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(grad + token * width_bytes + column));
            const DataCopyExtParams copy{1, bytes, 0, 0, 0};
            const DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
            DataCopyPad(data, source, copy, pad);
            SetFlag<HardEvent::MTE2_MTE3>(0);
            WaitFlag<HardEvent::MTE2_MTE3>(0);
            for (int64_t k = 0; k < topk; ++k) {
                const int64_t row = token * topk + k;
                const int64_t target = indices.GetValue(row);
                GlobalTensor<uint8_t> destination;
                destination.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(output + target * width_bytes + column));
                DataCopyPad(destination, data, copy);
                if (column == 0) {
                    SetFlag<HardEvent::MTE3_S>(1);
                    WaitFlag<HardEvent::MTE3_S>(1);
                    probability.SetValue(0, probs.GetValue(row));
                    SetFlag<HardEvent::S_MTE3>(1);
                    WaitFlag<HardEvent::S_MTE3>(1);
                    GlobalTensor<float> destination_probability;
                    destination_probability.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(staged_probabilities) + target);
                    const DataCopyExtParams scalar{1, sizeof(float), 0, 0, 0};
                    DataCopyPad(destination_probability, probability, scalar);
                }
            }
        }
    }
    PipeBarrier<PIPE_ALL>();
}
}
extern "C" void HmcLaunchPermuteFromMapping(unsigned blocks,void* stream,uint8_t* grad,uint8_t* mapping,
    uint8_t* probs,uint8_t* output,uint8_t* staged,int64_t tokens,int64_t width_bytes,int64_t topk) {
    PermuteFromMapping<<<blocks,nullptr,stream>>>(grad,mapping,probs,output,staged,tokens,width_bytes,topk);
}
