namespace {
using namespace AscendC;
constexpr int32_t kTileBytes = 32 * 1024;

__global__ __aicore__ void ZeroEmptyExpertGrad(
    GM_ADDR first, GM_ADDR second, GM_ADDR cumulative,
    int64_t first_expert_bytes, int64_t second_expert_bytes, int64_t experts) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, kTileBytes);
    auto zeros = buffer.Get<int32_t>();
    bool initialized = false;
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(cumulative));
    // A row is cold precisely when its cumulative count equals the previous
    // cumulative count. Every block scans only this short metadata vector.
    for (int64_t expert = 0; expert < experts; ++expert) {
        const int64_t before = expert == 0 ? 0 : groups.GetValue(expert - 1);
        if (groups.GetValue(expert) != before) {
            continue;
        }
        if (!initialized) {
            Duplicate(zeros, int32_t(0), kTileBytes / sizeof(int32_t));
            PipeBarrier<PIPE_ALL>();
            initialized = true;
        }
        for (int32_t projection = 0; projection < 2; ++projection) {
            const int64_t bytes = projection == 0 ? first_expert_bytes : second_expert_bytes;
            GM_ADDR base = projection == 0 ? first : second;
            for (int64_t offset = static_cast<int64_t>(GetBlockIdx()) * kTileBytes;
                 offset < bytes; offset += static_cast<int64_t>(GetBlockNum()) * kTileBytes) {
                const int32_t count = bytes - offset < kTileBytes ? bytes - offset : kTileBytes;
                GlobalTensor<uint8_t> target;
                target.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(base + expert * bytes + offset));
                const DataCopyExtParams copy{1, static_cast<uint32_t>(count), 0, 0, 0};
                DataCopyPad(target, zeros.ReinterpretCast<uint8_t>(), copy);
            }
        }
    }
    PipeBarrier<PIPE_ALL>();
}
}  // namespace
extern "C" void HMC_UTILITY(HmcLaunchZeroCold)(unsigned blocks, void* stream, uint8_t* first,
                                   uint8_t* second, uint8_t* cumulative,
                                   int64_t first_bytes, int64_t second_bytes, int64_t experts) {
    ZeroEmptyExpertGrad<<<blocks, nullptr, stream>>>(first, second, cumulative, first_bytes, second_bytes, experts);
}

// PR19 routing_kernels.h, adapted to HyperMulticore row units.
using namespace AscendC;
namespace {
__aicore__ inline int64_t device_aligned(int64_t n) { return (n+7)/8*8; }
template <typename T>
__aicore__ inline void Load(LocalTensor<T> local, GM_ADDR address, int64_t count) {
    GlobalTensor<T> global;
    global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(address));
    DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
    DataCopyPadExtParams<T> pad{false, 0, 0, 0};
    DataCopyPad(local, global, copy, pad);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
}

template <typename T>
__aicore__ inline void Store(GM_ADDR address, LocalTensor<T> local, int64_t count) {
    GlobalTensor<T> global;
    global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(address));
    SetFlag<HardEvent::S_MTE3>(0);
    WaitFlag<HardEvent::S_MTE3>(0);
    DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
    DataCopyPad(global, local, copy);
    SetFlag<HardEvent::MTE3_S>(0);
    WaitFlag<HardEvent::MTE3_S>(0);
}

__aicore__ inline void SummarizeRoute(LocalTensor<int32_t> payload, LocalTensor<int64_t> output,
                                      GM_ADDR summary, int32_t peers, int32_t experts,
                                      int32_t row_stride, int32_t block, int32_t blocks) {
    const int32_t local = experts / peers;
    for (int32_t rank = block; rank < peers; rank += blocks) {
        const int32_t row = rank * row_stride;
        int64_t source_total = 0;
        int32_t source_min = INT32_MAX, source_max = INT32_MIN;
        for (int32_t expert = 0; expert < experts; ++expert) {
            const int32_t count = payload.GetValue(row + 3 + expert);
            source_total += count;
            source_min = count < source_min ? count : source_min;
            source_max = count > source_max ? count : source_max;
        }
        int64_t owner_total = 0, owner_min = INT64_MAX;
        for (int32_t expert = 0; expert < local; ++expert) {
            const int32_t column = 3 + rank * local + expert;
            int64_t load = 0;
            for (int32_t source = 0; source < peers; ++source) {
                load += payload.GetValue(source * row_stride + column);
            }
            owner_total += load;
            owner_min = load < owner_min ? load : owner_min;
        }
        output.SetValue(0, payload.GetValue(row));
        output.SetValue(1, payload.GetValue(row + 1));
        output.SetValue(2, payload.GetValue(row + 2));
        output.SetValue(3, source_total);
        output.SetValue(4, source_min);
        output.SetValue(5, source_max);
        output.SetValue(6, owner_total);
        output.SetValue(7, owner_min);
        Store(summary + rank * 8 * sizeof(int64_t), output, 8);
    }
}

__global__ __aicore__ void Metadata(GM_ADDR input, GM_ADDR offsets, GM_ADDR sizes, GM_ADDR summary,
                                  int32_t p, int32_t e, int32_t rank, int32_t hidden_size,
                                  int32_t stride, int32_t group, int32_t programs,
                                  int32_t bytes, int32_t row_stride) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, bytes);
    auto memory = buffer.Get<int32_t>();
    const int32_t header = summary == nullptr ? 0 : 3;
    const int32_t span = (p - 1) * row_stride + e + header;
    const auto scratch = device_aligned(span);
    auto out = memory[scratch].ReinterpretCast<int64_t>();
    Load(memory, input, span);
    const int32_t block = GetBlockIdx();
    if (summary != nullptr && block >= 2 * programs) {
        SummarizeRoute(memory, out, summary, p, e, row_stride, block - 2 * programs, GetBlockNum() - 2 * programs);
        return;
    }
    auto length = memory[scratch + 2 * stride];
    auto groups = memory[scratch + 3 * stride].ReinterpretCast<int64_t>();
    const int32_t local = e / p;
    // Reuse the same loaded count table and UB scratch for both unit systems.
    for (int pass=0; pass<(hidden_size==1?1:2); ++pass) {
        const int32_t h=pass==0?1:hidden_size;
        auto output_offsets=offsets+static_cast<int64_t>(pass)*(4*stride+local)*8;
        auto output_sizes=sizes+static_cast<int64_t>(pass)*2*stride*4;
    if (block < programs) {
        for (int32_t source = block * group; source < p && source < (block + 1) * group; ++source) {
            int64_t prefix = 0;
            for (int32_t expert = 0; expert < e; ++expert) {
                int64_t n = memory.GetValue(source * row_stride + header + expert);
                out.SetValue(expert, static_cast<int64_t>(static_cast<uint64_t>(prefix) * h));
                if (source == rank) length.SetValue(expert, static_cast<int32_t>(n * h));
                prefix += n;
            }
            if (source == rank) {
                Store(output_offsets, out, e);
                Store(output_sizes, length, e);
            }
            for (int32_t j = 0; j < local; ++j) groups.SetValue(j, out.GetValue(rank * local + j));
            Store(output_offsets + (3 * stride + source * local) * 8, groups, local);
        }
    } else {
        int32_t begin = (block - programs) * group;
        for (int32_t dest = begin; dest < p && dest < begin + group; ++dest) {
            int64_t prefix = 0;
            for (int32_t j = 0; j < local; ++j) {
                int64_t source_prefix = 0;
                for (int32_t source = 0; source < p; ++source) {
                    int64_t n = memory.GetValue(source * row_stride + header + dest * local + j);
                    out.SetValue(source * local + j,
                                 static_cast<int64_t>(static_cast<uint64_t>(prefix + source_prefix) * h));
                    if (dest == rank) length.SetValue(source * local + j, static_cast<int32_t>(n * h));
                    source_prefix += n;
                }
                prefix += source_prefix;
                groups.SetValue(j, prefix);
            }
            if (dest == rank) {
                Store(output_offsets + 2 * stride * 8, out, e);
                Store(output_sizes + stride * 4, length, e);
                Store(output_offsets + 4 * stride * 8, groups, local);
            }
            for (int32_t j = 0; j < local; ++j) groups.SetValue(j, out.GetValue(rank * local + j));
            Store(output_offsets + (stride + dest * local) * 8, groups, local);
        }
    }
    }
}


}
extern "C" void HMC_UTILITY(HmcLaunchRouteMetadata)(unsigned blocks, void* stream, uint8_t* counts,
    uint8_t* offsets, uint8_t* sizes, uint8_t* summary, int32_t ep, int32_t experts, int32_t rank,
    int32_t stride, int32_t group, int32_t programs, int32_t bytes, int32_t row_stride, int32_t hidden_size) {
    Metadata<<<blocks, nullptr, stream>>>(
        counts, offsets, sizes, summary, ep, experts, rank, hidden_size, stride, group, programs, bytes, row_stride);
}

// Reuse a validated forward permutation; no sorting or floating-point arithmetic.
namespace {
__global__ __aicore__ void PermuteFromMapping(
    GM_ADDR grad, GM_ADDR mapping, GM_ADDR probabilities, GM_ADDR output,
    GM_ADDR staged_probabilities, int64_t tokens, int64_t width_bytes, int64_t topk) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> data_buffer, probability_buffer;
    pipe.InitBuffer(data_buffer, kTileBytes);
    pipe.InitBuffer(probability_buffer, 32);
    auto data = data_buffer.Get<uint8_t>();
    auto probability = probability_buffer.Get<float>();
    GlobalTensor<int32_t> indices;
    GlobalTensor<float> probs;
    indices.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(mapping));
    probs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(probabilities));
    for (int64_t token = GetBlockIdx(); token < tokens; token += GetBlockNum()) {
        for (int64_t column = 0; column < width_bytes; column += kTileBytes) {
            const uint32_t bytes = width_bytes - column < kTileBytes ? width_bytes - column : kTileBytes;
            SetFlag<HardEvent::MTE3_MTE2>(0);
            WaitFlag<HardEvent::MTE3_MTE2>(0);
            GlobalTensor<uint8_t> source;
            source.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(grad + token * width_bytes + column));
            const DataCopyExtParams copy{1, bytes, 0, 0, 0};
            const DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
            DataCopyPad(data, source, copy, pad);
            SetFlag<HardEvent::MTE2_MTE3>(0);
            WaitFlag<HardEvent::MTE2_MTE3>(0);
            for (int64_t k = 0; k < topk; ++k) {
                const int64_t row = token * topk + k;
                const int64_t target = indices.GetValue(row);
                GlobalTensor<uint8_t> destination;
                destination.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(output + target * width_bytes + column));
                DataCopyPad(destination, data, copy);
                if (column == 0) {
                    SetFlag<HardEvent::MTE3_S>(1);
                    WaitFlag<HardEvent::MTE3_S>(1);
                    probability.SetValue(0, probs.GetValue(row));
                    SetFlag<HardEvent::S_MTE3>(1);
                    WaitFlag<HardEvent::S_MTE3>(1);
                    GlobalTensor<float> destination_probability;
                    destination_probability.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(staged_probabilities) + target);
                    const DataCopyExtParams scalar{1, sizeof(float), 0, 0, 0};
                    DataCopyPad(destination_probability, probability, scalar);
                }
            }
        }
    }
    PipeBarrier<PIPE_ALL>();
}
}
extern "C" void HMC_UTILITY(HmcLaunchPermuteFromMapping)(unsigned blocks,void* stream,uint8_t* grad,uint8_t* mapping,
    uint8_t* probs,uint8_t* output,uint8_t* staged,int64_t tokens,int64_t width_bytes,int64_t topk) {
    PermuteFromMapping<<<blocks,nullptr,stream>>>(grad,mapping,probs,output,staged,tokens,width_bytes,topk);
}

#if HMC_UTILITY_ARCH == 3510
namespace {
constexpr uint32_t kSummaryThreads = 32;
constexpr uint32_t kSummaryFields = 8;
constexpr uint32_t kRouteHeader = 3;

template <bool UseNddma>
__simt_vf__ __launch_bounds__(kSummaryThreads) inline void SummarizeMxRoutes(
    __gm__ const int32_t* payload, __ubuf__ const int32_t* source_tile,
    __ubuf__ const int32_t* owners_tile, __gm__ int64_t* output,
    uint32_t peers, uint32_t experts, uint32_t width, uint32_t worker, uint32_t workers) {
    const uint32_t lane = threadIdx.x;
    const uint32_t stride = experts + kRouteHeader;
    const uint32_t local = experts / peers;
    const uint32_t group = lane / width;
    const uint32_t expert_lane = lane % width;
    for (uint32_t rank = worker; rank < peers; rank += workers) {
        const uint32_t begin = rank * stride;
        int64_t source_sum = 0;
        int32_t source_min = INT32_MAX;
        int32_t source_max = INT32_MIN;
        for (uint32_t e = lane; e < experts; e += kSummaryThreads) {
            const int32_t count = UseNddma ? source_tile[kRouteHeader + e] : payload[begin + kRouteHeader + e];
            source_sum += count;
            source_min = count < source_min ? count : source_min;
            source_max = count > source_max ? count : source_max;
        }
        int64_t receive_sum = 0;
        int64_t receive_min = INT64_MAX;
        for (uint32_t offset = 0; offset < local; offset += width) {
            const uint32_t col = rank * local + offset + expert_lane;
            const bool live = offset + expert_lane < local;
            int64_t load = 0;
            if (live) {
                // Lanes sharing an expert sum disjoint sets of source ranks.
                for (uint32_t peer = group; peer < peers; peer += kSummaryThreads / width) {
                    if constexpr (UseNddma) {
                        load += owners_tile[(offset + expert_lane) * peers + peer];
                    } else {
                        load += payload[peer * stride + kRouteHeader + col];
                    }
                }
            }
            for (uint32_t shift = kSummaryThreads / 2; shift >= width; shift /= 2) {
                load += asc_shfl_xor(load, shift);
            }
            if (group == 0 && live) {
                receive_sum += load;
                receive_min = load < receive_min ? load : receive_min;
            }
        }
        for (uint32_t shift = kSummaryThreads / 2; shift > 0; shift /= 2) {
            source_sum += asc_shfl_down(source_sum, shift);
            const int32_t low = asc_shfl_down(source_min, shift);
            const int32_t high = asc_shfl_down(source_max, shift);
            source_min = low < source_min ? low : source_min;
            source_max = high > source_max ? high : source_max;
            receive_sum += asc_shfl_down(receive_sum, shift);
            const int64_t least = asc_shfl_down(receive_min, shift);
            receive_min = least < receive_min ? least : receive_min;
        }
        auto row = output + rank * kSummaryFields;
        if (lane < kRouteHeader) row[lane] = UseNddma ? source_tile[lane] : payload[begin + lane];
        if (lane == 0) {
            row[3] = source_sum;
            row[4] = source_min;
            row[5] = source_max;
            row[6] = receive_sum;
            row[7] = receive_min;
        }
    }
}

__global__ __vector__ void MxRouteSummary(__gm__ const int32_t* payload, __gm__ int64_t* output,
                                        uint32_t peers, uint32_t experts, uint32_t width, uint32_t workers) {
    InitSocState();
    const auto empty = static_cast<__ubuf__ const int32_t*>(nullptr);
    asc_vf_call<SummarizeMxRoutes<false>>(dim3(kSummaryThreads), payload, empty, empty, output,
                                          peers, experts, width, static_cast<uint32_t>(GetBlockIdx()), workers);
    PipeBarrier<PIPE_ALL>();
}
}  // namespace

__global__ __vector__ void MxRouteSummaryNddma(__gm__ const int32_t* payload, __gm__ int64_t* output,
                                             uint32_t peers, uint32_t experts, uint32_t width,
                                             uint32_t workers, uint32_t row_words) {
    extern __ubuf__ int32_t scratch[];
    InitSocState();
    const auto base = reinterpret_cast<uint64_t>(scratch);
    const uint32_t stride = experts + kRouteHeader;
    const uint32_t local = experts / peers;
    LocalTensor<int32_t> row(TPosition::VECIN, base, row_words);
    LocalTensor<int32_t> owners(TPosition::VECIN, base + row_words * sizeof(int32_t), experts);
    GlobalTensor<int32_t> input;
    input.SetGlobalBuffer(const_cast<__gm__ int32_t*>(payload), peers * stride);
    NdDmaDci();
    for (uint32_t rank = GetBlockIdx(); rank < peers; rank += workers) {
        const DataCopyExtParams line{1, static_cast<uint32_t>(stride * sizeof(int32_t)), 0, 0, 0};
        const DataCopyPadExtParams<int32_t> padding{false, 0, 0, 0};
        DataCopyPad(row, input[rank * stride], line, padding);
        // Bring the whole strided owner slice into UB in local-expert-major order.
        const NdDmaLoopInfo<2> info{{1, stride}, {peers, 1}, {local, peers}, {0, 0}, {0, 0}};
        const NdDmaParams<int32_t, 2> params{info, 0};
        DataCopy<int32_t, 2>(owners, input[kRouteHeader + rank * local], params);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        const auto empty = static_cast<__gm__ const int32_t*>(nullptr);
        asc_vf_call<SummarizeMxRoutes<true>>(dim3(kSummaryThreads), empty, scratch, scratch + row_words, output,
                                             peers, experts, width, rank, peers);
        DataSyncBarrier<MemDsbT::UB>();
        PipeBarrier<PIPE_ALL>();
    }
}
extern "C" void HMC_UTILITY(HmcLaunchMxRouteSummary)(
    unsigned workers, void* stream, const int32_t* payload, int64_t* output,
    uint32_t peers, uint32_t experts, bool nddma) {
    uint32_t width = 1;
    while (width < experts / peers && width < kSummaryThreads) width *= 2;
    if (nddma) {
        const uint32_t row_words = (experts + kRouteHeader + 7) / 8 * 8;
        const uint32_t ub_bytes = (row_words + (experts + 7) / 8 * 8) * sizeof(int32_t);
        MxRouteSummaryNddma<<<workers, ub_bytes, stream>>>(payload, output, peers, experts, width, workers, row_words);
    } else {
        MxRouteSummary<<<workers, nullptr, stream>>>(payload, output, peers, experts, width, workers);
    }
}
#endif
